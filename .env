# Hadoop Test Stack Configuration
HADOOP_VERSION=3.3.6
HADOOP_IMAGE=sbloodys/hadoop
HIVE_VERSION=4.1.0
HUE_VERSION=4.11.0

# Exposed Ports
NAMENODE_WEB_PORT=9870
NAMENODE_RPC_PORT=9900
DATANODE_WEB_PORT=9864
METASTORE_PORT=9083
HIVESERVER2_PORT=10000
HIVESERVER2_WEB_PORT=10002
HUE_PORT=8888

# Hue credentials (local testing only)
HUE_ADMIN_USER=admin
HUE_ADMIN_PASSWORD=admin

# Resource limits
CONTAINER_MEMORY_LIMIT=2g
CONTAINER_CPU_LIMIT=1.0
