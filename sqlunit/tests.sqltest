# Test Name | SQL Query | Expected Result
# === SCHEMA EXISTENCE ===
HAM_DCM schema exists | SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = 'HAM_DCM'; | true
HAM_RAW_V001 schema exists | SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME = 'HAM_RAW_V001'; | true
# === STAGE EXISTENCE ===
HAMI_RAW_ST_ICEBERG stage exists | SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.STAGES WHERE STAGE_SCHEMA = 'HAM_RAW_V001' AND STAGE_NAME = 'HAMI_RAW_ST_ICEBERG'; | true
Stage uses PARQUET file format | SELECT CASE WHEN STAGE_TYPE = 'External Named' THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.STAGES WHERE STAGE_SCHEMA = 'HAM_RAW_V001' AND STAGE_NAME = 'HAMI_RAW_ST_ICEBERG'; | true
# === DCM PROJECT ===
DCM project exists | SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END AS result FROM TABLE(RESULT_SCAN(LAST_QUERY_ID())); | true
# === NAMING CONVENTION ===
All schemas follow naming standard | SELECT CASE WHEN COUNT(*) = 0 THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME NOT IN ('INFORMATION_SCHEMA', 'PUBLIC', 'HAM_DCM', 'HAM_RAW_V001') AND SCHEMA_NAME NOT LIKE 'HAM_%'; | true
Stage name follows convention | SELECT CASE WHEN COUNT(*) > 0 THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.STAGES WHERE STAGE_NAME LIKE 'HAMI_RAW_ST_%'; | true
# === STORAGE INTEGRATION ===
Stage URL points to S3 | SELECT CASE WHEN STAGE_URL LIKE 's3://mdaeppen/hadoop-root/%' THEN 'true' ELSE 'false' END AS result FROM {{DATABASE}}.INFORMATION_SCHEMA.STAGES WHERE STAGE_SCHEMA = 'HAM_RAW_V001' AND STAGE_NAME = 'HAMI_RAW_ST_ICEBERG'; | true
